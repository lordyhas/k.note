{
  "name": "knote-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security tests for firestore.rules, run against the Firestore emulator.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-knote \"node --test rules.test.mjs\"",
    "test:only": "node --test rules.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0"
  }
}
